# Local Compose configuration. Replace placeholders before exposing the stack.
# Keep POSTGRES_PASSWORD URL-safe (letters/numbers/hyphens) for DATABASE_URL.
POSTGRES_DB=incident
POSTGRES_USER=incident
POSTGRES_PASSWORD=local-only-change-me-please
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=3000
FRONTEND_PORT=3001

# Authentication and protected metrics endpoint: use random values locally.
JWT_SECRET=replace-with-at-least-32-random-characters
METRICS_TOKEN=replace-with-at-least-24-random-characters

# Compose service/application settings.
REDIS_PREFIX=incident
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=0
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_REALTIME_ENABLED=true

# Optional email delivery. Leave disabled unless SMTP values are supplied.
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional monitoring and limits.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
RATE_LIMIT_POINTS=120
RATE_LIMIT_DURATION=60
LOGIN_RATE_LIMIT_POINTS=5
LOGIN_RATE_LIMIT_DURATION=60
LOGIN_RATE_LIMIT_BLOCK_DURATION=900
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
QUEUE_WORKER_CONCURRENCY=5
